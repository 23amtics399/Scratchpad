{
  "name": "scratchpad",
  "private": true,
  "version": "1.0.0",
  "description": "A production-grade, local-first web notepad and document editor workspace.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/23amtics399/Scratchpad.git"
  },
  "keywords": [
    "scratchpad",
    "notepad",
    "local-first",
    "tiptap",
    "codemirror",
    "indexeddb",
    "dexie",
    "react",
    "editor"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
